# .easignore

# ---------------------------------------
# Build Artifacts & Dependencies
# ---------------------------------------
node_modules/
.expo/
dist/
web-build/
npm-debug.*
yarn-debug.*
yarn-error.*

# ---------------------------------------
# Native Projects (generated by prebuild)
# ---------------------------------------
# Keep these ignored if you use "npx expo prebuild" (CNG)
ios/
android/
.kotlin/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# ---------------------------------------
# Environment & Secrets
# ---------------------------------------
# STRICTLY IGNORE: Use EAS Secrets for these values instead
.env
.env.*
.env.local

# ---------------------------------------
# Firebase Config
# ---------------------------------------
# NOTE: If you need these for the build and haven't set them up
# in app.json or EAS Credentials, you might need to un-comment
# the lines below (remove the '#') to upload them to EAS.
# !google-services.json
# !GoogleService-Info.plist

# ---------------------------------------
# System & Editor Files
# ---------------------------------------
.DS_Store
.vscode/
.idea/
*.pem
*.tsbuildinfo